# GitHub Pages repository path. Use / for a root-domain deployment.
VITE_BASE_PATH=/wuhan-uni-guide/

# HTTPS endpoint of the deployed sync Worker. Leave empty for local-only mode.
VITE_SYNC_API=

# Licensed GCJ-02 raster tile template required for production builds.
# The local dev server uses a development-only Amap-compatible endpoint when empty.
VITE_MAP_TILE_URL=
VITE_MAP_ATTRIBUTION=
